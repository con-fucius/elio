# Elio API — local development template
# Copy to .env and fill secrets. Do not commit .env.
# Generate JWT keys: uv run python scripts/gen_dev_keys.py

ELIO_ENVIRONMENT=development
ELIO_DEBUG=true
ELIO_LOG_JSON=false
ELIO_DATABASE_URL=postgresql+asyncpg://elio:elio@localhost:5432/elio
ELIO_AUTH_ENABLED=true
ELIO_ALLOW_PASSWORD_LOGIN=true
ELIO_JWT_ISSUER=https://elio.local/realms/dev
ELIO_JWT_AUDIENCE=elio-api
ELIO_JWT_ALGORITHM=RS256
# ELIO_JWT_PRIVATE_KEY_PEM=
# ELIO_JWT_PUBLIC_KEY_PEM=
ELIO_EVIDENCE_ROOT=var/evidence
# Anti-abuse (production values; set 0 to disable for local tests)
ELIO_MIN_EXECUTION_SECONDS=120
ELIO_MIN_EVIDENCE_BYTES=64
ELIO_EVIDENCE_REUSE_WINDOW_HOURS=72
